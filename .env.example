# Copia este archivo a .env antes de levantar el proyecto: cp .env.example .env
# Los valores sirven para ejecutar en local. No son secretos reales.

# PostgreSQL (contenedor db)
POSTGRES_USER=valorant
POSTGRES_PASSWORD=valorant
POSTGRES_DB=valorant
# Puerto de la base de datos en tu máquina (solo localhost). Cámbialo si 5433 está ocupado.
DB_PORT=5433

# Solo para ejecutar la API fuera de Docker (desarrollo y pruebas).
# Dentro de Docker, docker-compose.yml construye su propia URL.
DATABASE_URL=postgresql://valorant:valorant@localhost:5433/valorant

# Firma de la cookie de sesión. Cámbialo por una cadena larga y aleatoria.
JWT_SECRET=cambia-este-valor-por-una-cadena-larga-y-aleatoria

# Orígenes desde los que se aceptan escrituras (separados por comas).
# 8080 = aplicación en Docker; 5173 = servidor de desarrollo de Vite.
APP_ORIGIN=http://localhost:8080,http://localhost:5173

# true solo si se sirve por HTTPS.
COOKIE_SECURE=false

# Puerto de la aplicación web en tu máquina.
WEB_PORT=8080
